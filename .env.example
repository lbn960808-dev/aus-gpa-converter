# ==== Application ====
APP_ENV=development
DEBUG=true
# 產生方式: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key

# ==== Server ====
HOST=127.0.0.1
PORT=8000

# ==== Database ====
DATABASE_URL=sqlite:///./app.db

# ==== API ====
API_BASE_URL=http://localhost:8080

